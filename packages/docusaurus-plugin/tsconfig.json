{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "jsx": "react-jsx",
    "module": "CommonJS",
    "moduleResolution": "Node"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/theme/**",
    "dist"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../indexer"
    },
    {
      "path": "../runtime"
    }
  ]
}
