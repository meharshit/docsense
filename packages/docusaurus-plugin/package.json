{
  "name": "docusaurus-plugin-docsense",
  "version": "0.1.0",
  "description": "Docusaurus plugin + SearchBar theme for Docsense (build-time local search).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/theme"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:theme",
    "copy:theme": "node ./scripts/copy-theme.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@docsense/core": "0.1.0",
    "@docsense/indexer": "0.1.0",
    "@docsense/runtime": "0.1.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@docusaurus/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
