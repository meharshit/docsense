{
  "name": "docusaurus-plugin-docsense",
  "version": "0.1.1",
  "description": "Docusaurus plugin + SearchBar theme for Docsense (build-time local search).",
  "license": "MIT",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "docusaurus-v3",
    "documentation",
    "search",
    "local-search",
    "docsense",
    "markdown",
    "mdx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meharshit/docsense.git",
    "directory": "packages/docusaurus-plugin"
  },
  "homepage": "https://meharshit.github.io/docsense/",
  "bugs": {
    "url": "https://github.com/meharshit/docsense/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/theme",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:theme",
    "copy:theme": "node ./scripts/copy-theme.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@docsense/core": "0.1.0",
    "@docsense/indexer": "0.1.0",
    "@docsense/runtime": "0.1.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/theme-common": "^3.0.0",
    "@docusaurus/useGlobalData": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@docusaurus/core": {
      "optional": true
    },
    "@docusaurus/theme-common": {
      "optional": true
    },
    "@docusaurus/useGlobalData": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
