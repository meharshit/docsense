{
  "name": "@docsense/indexer",
  "version": "0.1.0",
  "description": "Build Docsense search indexes from Markdown/MDX source files.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@docsense/core": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
