{
  "name": "docsense",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, build-time docs search for Docusaurus — no Algolia account, no crawl lag.",
  "license": "MIT",
  "author": "meharshit",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run copy:theme -w docusaurus-plugin-docsense",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
